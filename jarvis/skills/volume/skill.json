{
  "id": "volume",
  "name": "Громкость и звук",
  "description": "Громче, тише, выключить и включить звук.",
  "version": "1.0",
  "entry": "handler.py",
  "permissions": { "shell": true, "notify": false },
  "examples": ["громче", "тише", "выключи звук", "включи звук"],
  "actions": [
    {
      "id": "up",
      "phrases": ["громче", "сделай громче", "прибавь звук", "увеличь громкость"],
      "description": "Прибавить громкость на 10%",
      "tags": ["audio"]
    },
    {
      "id": "down",
      "phrases": ["тише", "сделай тише", "убавь звук", "уменьши громкость"],
      "description": "Убавить громкость на 10%",
      "tags": ["audio"]
    },
    {
      "id": "mute",
      "phrases": ["выключи звук", "выключи звук полностью", "молчание", "мьют"],
      "description": "Выключить звук",
      "tags": ["audio"]
    },
    {
      "id": "unmute",
      "phrases": ["включи звук", "верни звук", "сними мьют"],
      "description": "Включить звук",
      "tags": ["audio"]
    }
  ]
}
