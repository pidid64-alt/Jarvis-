{
  "id": "dialogue",
  "name": "Беседа",
  "description": "Приветствие, вопросы о состоянии, «что ты умеешь», прощание.",
  "version": "1.0",
  "entry": "handler.py",
  "permissions": { "shell": false, "network": false, "notify": false },
  "examples": ["привет", "как дела", "что ты умеешь", "спасибо"],
  "actions": [
    {
      "id": "hello",
      "phrases": ["привет", "здравствуй", "добрый день", "доброе утро", "добрый вечер", "джарвис привет"],
      "description": "Поздороваться",
      "tags": ["meta"]
    },
    {
      "id": "how_are_you",
      "phrases": ["как дела", "как ты", "как настроение", "ты тут", "ты на связи"],
      "description": "Рассказать, как дела",
      "tags": ["meta"]
    },
    {
      "id": "capabilities",
      "phrases": ["что ты умеешь", "какие команды", "список команд", "что ты можешь", "помощь"],
      "description": "Показать, что умеет ассистент",
      "tags": ["meta"]
    },
    {
      "id": "thanks",
      "phrases": ["спасибо", "благодарю", "спасибо за помощь"],
      "description": "Ответить на благодарность",
      "tags": ["meta"]
    },
    {
      "id": "bye",
      "phrases": ["пока", "до свидания", "отдыхай", "спокойной ночи"],
      "description": "Попрощаться",
      "tags": ["meta"]
    }
  ]
}
