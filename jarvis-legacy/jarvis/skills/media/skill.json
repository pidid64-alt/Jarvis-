{
  "id": "media",
  "name": "Медиаплеер",
  "description": "Пауза, следующий и предыдущий трек, остановка воспроизведения.",
  "version": "1.0",
  "entry": "handler.py",
  "permissions": {
    "shell": true,
    "notify": false
  },
  "examples": [
    "пауза",
    "следующий трек",
    "предыдущий трек",
    "останови музыку"
  ],
  "actions": [
    {
      "id": "play_pause",
      "phrases": [
        "пауза",
        "продолжи музыку",
        "включи музыку",
        "поставь на паузу"
      ],
      "description": "Пауза или продолжение воспроизведения",
      "tags": [
        "media"
      ]
    },
    {
      "id": "next",
      "phrases": [
        "следующий трек",
        "переключи трек",
        "следующая песня",
        "дальше"
      ],
      "description": "Следующий трек",
      "tags": [
        "media"
      ]
    },
    {
      "id": "prev",
      "phrases": [
        "предыдущий трек",
        "верни трек",
        "предыдущая песня"
      ],
      "description": "Предыдущий трек",
      "tags": [
        "media"
      ]
    },
    {
      "id": "stop",
      "phrases": [
        "останови музыку",
        "выключи музыку",
        "стоп музыка",
        "останови плеер"
      ],
      "description": "Остановить воспроизведение",
      "tags": [
        "media"
      ]
    }
  ]
}
