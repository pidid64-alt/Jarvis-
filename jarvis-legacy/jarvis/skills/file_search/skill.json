{
  "id": "file_search",
  "name": "Поиск файлов",
  "description": "Ищет файл или папку по имени в домашних папках: рабочий стол, загрузки, документы.",
  "version": "1.0",
  "entry": "handler.py",
  "permissions": {
    "shell": false,
    "files": true,
    "notify": false
  },
  "examples": [
    "найди файл загрузки.txt",
    "где файл отчёт",
    "найди папку проекты"
  ],
  "actions": [
    {
      "id": "find",
      "phrases": [
        "найди файл",
        "найти файл",
        "где файл",
        "где находится файл",
        "найди папку",
        "найти папку",
        "где папка",
        "поищи файл"
      ],
      "description": "Найти файл или папку по имени",
      "capture": true,
      "tags": [
        "files"
      ]
    }
  ]
}
