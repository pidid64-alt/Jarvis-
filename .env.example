# ============================================================
# «Джарвис» — секреты. Скопируйте в .env и заполните:
#   cp .env.example .env
# Файл .env исключён из git — храните только локально.
# ============================================================

# --- Модель (LLM) -------------------------------------------
# Провайдер: openai_compat (OpenRouter/Groq/Ollama и любые
# OpenAI-совместимые API) или anthropic.
JARVIS_LLM_PROVIDER=openai_compat

# Бесплатный вариант 1 — OpenRouter (https://openrouter.ai):
#   1) зарегистрируйтесь, создайте ключ на /keys
#   2) выберите модель с суффиксом :free на /models
JARVIS_LLM_BASE_URL=https://openrouter.ai/api/v1
JARVIS_LLM_API_KEY=
JARVIS_LLM_MODEL=qwen/qwen3-14b:free

# Бесплатный вариант 2 — Groq (https://console.groq.com):
# JARVIS_LLM_BASE_URL=https://api.groq.com/openai/v1
# JARVIS_LLM_API_KEY=
# JARVIS_LLM_MODEL=llama-3.3-70b-versatile

# Локальный вариант — Ollama (https://ollama.com):
# JARVIS_LLM_BASE_URL=http://localhost:11434/v1
# JARVIS_LLM_API_KEY=ollama
# JARVIS_LLM_MODEL=qwen2.5:7b

# --- Telegram (юзер-аккаунт, Telethon) ----------------------
# api_id и api_hash получить на https://my.telegram.org
# (API development tools -> создать приложение).
JARVIS_TELEGRAM_API_ID=
JARVIS_TELEGRAM_API_HASH=
JARVIS_TELEGRAM_PHONE=

# --- Telegram-бот управления (интерфейс этапа 1) ------------
# 1) в Telegram напиши @BotFather -> /newbot
# 2) придумай имя и @username бота -> получишь токен вида 123456:ABC-DEF...
JARVIS_TELEGRAM_BOT_TOKEN=
# Необязательно: твой числовой user_id (узнать у @userinfobot).
# Если пусто — владельцем станет первый, кто нажмёт /start у бота.
JARVIS_TELEGRAM_OWNER_ID=

# --- Пути (обычно менять не нужно) --------------------------
# Относительные пути считаются от корня проекта.
# JARVIS_DATA_DIR=data
# JARVIS_CONFIG_DIR=config
