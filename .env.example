# ============================================================
# «Джарвис» — секреты. Скопируйте в .env и заполните:
#   cp .env.example .env
# Файл .env исключён из git — храните только локально.
# ============================================================

# --- Модель (LLM) -------------------------------------------
# Провайдер: openai_compat (любой OpenAI-совместимый API) или anthropic.
# Все три варианта ниже бесплатные и поддерживают tool calling.
JARVIS_LLM_PROVIDER=openai_compat

# Вариант 1 — Groq (https://console.groq.com -> API Keys):
#   ~14 400 запросов/день, очень быстрый.
JARVIS_LLM_BASE_URL=https://api.groq.com/openai/v1
JARVIS_LLM_API_KEY=
JARVIS_LLM_MODEL=qwen/qwen3.8-27b

# Вариант 2 — GitHub Models (бесплатно любому GitHub-аккаунту):
#   ключ: github.com/settings/tokens -> Fine-grained PAT (Models: read)
#   модели: curl -H "Authorization: Bearer <PAT>" https://models.github.ai/inference/models
# JARVIS_LLM_BASE_URL=https://models.github.ai/inference
# JARVIS_LLM_API_KEY=github_pat_...
# JARVIS_LLM_MODEL=openai/gpt-oss-120b

# Вариант 3 — Ollama Cloud (https://ollama.com -> Settings -> API keys):
#   облачные модели без своей видеокарты: glm-5.3, gpt-oss:120b,
#   deepseek-v4.1-flash, kimi-k2.6, mistral-large-4 и др.
#   список: curl https://ollama.com/v1/models
# JARVIS_LLM_BASE_URL=https://ollama.com/v1
# JARVIS_LLM_API_KEY=
# JARVIS_LLM_MODEL=glm-5.3

# Вариант 4 — локальная Ollama (offline, слабые модели):
# JARVIS_LLM_BASE_URL=http://localhost:11434/v1
# JARVIS_LLM_API_KEY=ollama
# JARVIS_LLM_MODEL=qwen2.5:1.5b

# --- Telegram (юзер-аккаунт, Telethon) ----------------------
# api_id и api_hash получить на https://my.telegram.org
# (API development tools -> создать приложение).
JARVIS_TELEGRAM_API_ID=
JARVIS_TELEGRAM_API_HASH=
JARVIS_TELEGRAM_PHONE=

# --- Telegram-бот управления (интерфейс этапа 1) ------------
# 1) в Telegram напиши @BotFather -> /newbot
# 2) придумай имя и @username бота -> получишь токен вида 123456:ABC-DEF...
JARVIS_TELEGRAM_BOT_TOKEN=
# Необязательно: твой числовой user_id (узнать у @userinfobot).
# Если пусто — владельцем станет первый, кто нажмёт /start у бота.
JARVIS_TELEGRAM_OWNER_ID=

# --- Gmail (чтение писем по IMAP) ---------------------------
# Пароль приложения: myaccount.google.com -> Безопасность ->
# Двухэтапная аутентификация -> Пароли приложений (пробелы можно не убирать).
JARVIS_GMAIL_USER=
JARVIS_GMAIL_APP_PASSWORD=

# --- Пути (обычно менять не нужно) --------------------------
# Относительные пути считаются от корня проекта.
# JARVIS_DATA_DIR=data
# JARVIS_CONFIG_DIR=config
